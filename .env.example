# Django Security
SECRET_KEY=django-insecure-sua-chave-secreta-aqui-mude-em-producao
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Recommended production security flags
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Database
# SQLite em dev. Em produção, use DATABASE_URL no host onde o Django estiver rodando.
# DATABASE_URL=postgresql://user:password@localhost:5432/titas_db

# CORS - Domínios permitidos
# Adicione a URL do seu frontend público aqui.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_CREDENTIALS=False

# PythonAnywhere Deploy Notes
# 1. Crie conta em https://www.pythonanywhere.com
# 2. Crie/ative um virtualenv para o projeto
# 3. Configure o Web app para usar o virtualenv
