# Django Security
SECRET_KEY=django-insecure-sua-chave-secreta-aqui-mude-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite em dev, PostgreSQL no Railway)
# Para Railway: deixe vazio aqui, Railway adiciona DATABASE_URL automaticamente
# DATABASE_URL=postgresql://user:password@localhost:5432/titas_db

# CORS - Domínios permitidos
# Em produção no Railway, adicione seu URL: https://seu-app.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# Railway Deploy Notes
# 1. Crie conta em https://railway.app
# 2. Conecte seu GitHub repo
# 3. Adicione PostgreSQL service (Railway cria DATABASE_URL automaticamente)
# 4. Configure variáveis no painel do Railway:
#    - DEBUG=False
#    - SECRET_KEY=sua-secret-key
#    - ALLOWED_HOSTS=seu-app.railway.app
#    - CORS_ALLOWED_ORIGINS=https://seu-app.railway.app (seu frontend URL)
